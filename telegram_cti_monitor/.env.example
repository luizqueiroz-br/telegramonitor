# Copie para .env e preencha. `make setup` faz isso automaticamente.

# App do Telegram: https://my.telegram.org -> "API development tools".
# Crie um app uma vez e use estes dois valores.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telefone internacional da conta, usado apenas no primeiro login.
# Ex.: +5511999999999
TELEGRAM_PHONE=

# Arquivo onde a sessão fica salva (não precisa preencher).
SESSION_PATH=monitor.session

# Banco SQLite onde as mensagens são gravadas (para consultar depois).
DB_PATH=messages.db

# URL completa do endpoint de ingestão (o monitor não adiciona path).
# Ex.: https://SEU_HOST/api/v1/telegram/messages
# Deixe vazio para apenas imprimir no console (útil para testar).
CTI_API_URL=
# Token Bearer gerado no portal CTI. Obrigatório quando CTI_API_URL está definida.
CTI_API_TOKEN=

# IDs dos chats a monitorar, separados por vírgula. Ex.: -1001234567890,-1009876543210
# Vazio = monitora todos. O `make run` lista os IDs dos seus chats.
MONITORED_CHATS=

# --- Agente de triagem de links (opcional) ---
# Chave em https://openrouter.ai/keys. Vazio = agente desligado.
OPENROUTER_API_KEY=
# Modelo bom e barato; ajuste ao seu orçamento. Ex.: google/gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash
# Modelo leve (ranking Decisions). Se definido, vale para a triagem de mensagens
# e para a decisão de entrada do agente. Ex.: google/gemini-2.5-flash
OPENROUTER_MSG_MODEL=

# Lê os links t.me já gravados e classifica os grupos.
AGENT_ENABLED=true
# true = entra sozinho nos aprovados. false = só entra os aprovados no TUI (tecla y).
AGENT_AUTO_JOIN=false
# true = não entra em nada, só registra o que faria.
AGENT_DRY_RUN=false
# Envia até 2.000 caracteres do texto da mensagem ao OpenRouter como contexto.
AGENT_SEND_CONTEXT=true
# Score mínimo (0..1) para considerar fraude e entrar.
AGENT_MIN_SCORE=0.8

# Limites contra ban: contam TENTATIVAS (inclusive falhas), persistem no banco.
AGENT_MAX_JOINS_PER_HOUR=2
AGENT_MAX_JOINS_PER_DAY=6
# Quantos links classificar por varredura / intervalo entre varreduras.
AGENT_CLASSIFY_PER_SCAN=5
AGENT_SCAN_SECS=300
# Pausa entre entradas dentro da mesma varredura.
AGENT_JOIN_DELAY_SECS=60
