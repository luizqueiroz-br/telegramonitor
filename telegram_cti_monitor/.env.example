# Copie para .env e preencha. `make setup` faz isso automaticamente.

# App do Telegram: https://my.telegram.org -> "API development tools".
# Crie um app uma vez e use estes dois valores.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telefone internacional da conta, usado apenas no primeiro login.
# Ex.: +5511999999999
TELEGRAM_PHONE=

# Arquivo onde a sessão fica salva (não precisa preencher).
SESSION_PATH=monitor.session

# Banco SQLite onde as mensagens são gravadas (para consultar depois).
DB_PATH=messages.db

# URL da API CTI que recebe as mensagens (POST JSON).
# Deixe vazio para apenas imprimir no console (útil para testar).
CTI_API_URL=

# IDs dos chats a monitorar, separados por vírgula. Ex.: -1001234567890,-1009876543210
# Vazio = monitora todos. O `make run` lista os IDs dos seus chats.
MONITORED_CHATS=
